# 콜 섀도잉 툴 환경변수. 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.
# Copy this file to .env and fill in the values. .env is git-ignored.

# [필수] 노션 통합 토큰. https://www.notion.so/my-integrations 에서 만들고, 콜로그 DB 페이지에 그 통합을 연결한다.
# [required] Notion integration token. Create it at notion.so/my-integrations and connect it to your database page.
NOTION_TOKEN=secret_xxx

# [필수] 콜로그를 기록할 노션 데이터베이스 ID (DB URL에 있는 32자리 hex). 필요한 속성은 README 참고.
# [required] Notion database ID (the 32-hex string in the database URL). Required properties are listed in README.
NOTION_DATABASE_ID=

# [필수] 녹음 파일을 저장할 S3 버킷 이름. 전 세계에서 고유해야 하므로 계정 ID 등을 붙인다. 없으면 python setup.py가 만든다.
# [required] S3 bucket for recordings. Must be globally unique. `python setup.py` creates it if missing.
S3_BUCKET=call-shadowing-audio-<your-account-id>

# [선택] AWS 리전 / Bedrock 모델 ID / Transcribe 언어 코드
# [optional] AWS region / Bedrock model id / Transcribe language code
# AWS_REGION=ap-northeast-2
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# TRANSCRIBE_LANGUAGE=ko-KR

# [선택] Caller 셀렉터에 보일 이름들(쉼표 구분)과 기본 선택값. 섀도잉이면 팀원 이름을 나열한다. 기본값: Me
# [optional] Names shown in the Caller selector (comma-separated) and the default one. Default: Me
# CALLER_OPTIONS=Me,Teammate1,Teammate2
# DEFAULT_CALLER=Me

# [선택] AWS 자격증명 만료 시 UI에 보여줄 안내 문구. 회사별 갱신 명령을 넣어 두면 편하다. 홑따옴표로 감싼다.
# [optional] Hint shown in the UI when AWS credentials expire, e.g. your company's refresh command. Wrap in single quotes.
# AWS_CREDS_HINT='AWS credentials expired. Run: aws sso login --profile myprofile'
